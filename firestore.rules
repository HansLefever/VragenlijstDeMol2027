rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /qrGame/main {
      allow read: if true;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && resource.data.keys().hasOnly(['count'])
                    && resource.data.count is int
                    && request.resource.data.count is int
                    && request.resource.data.count == resource.data.count + 1;
      allow create, delete: if false;
    }

    match /responses/{participant} {
      allow create, update: if request.resource.data.keys().hasOnly([
        'name','answers','answerDetails','openAnswers','openAnswerDetails','submittedAt','version'
      ])
      && request.resource.data.name is string
      && request.resource.data.answers is list
      && request.resource.data.answers.size() == 29
      && request.resource.data.answerDetails is list
      && request.resource.data.answerDetails.size() == 29
      && request.resource.data.openAnswers is list
      && request.resource.data.openAnswers.size() == 11
      && request.resource.data.openAnswerDetails is list
      && request.resource.data.openAnswerDetails.size() == 11;

      allow read: if request.auth != null;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
